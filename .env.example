# Omni MCP server configuration.
# Copy to .env and fill in. NEVER commit .env.

# Your instance URL, e.g. https://your-instance.omniapp.co
# A trailing /api is accepted and normalised away.
OMNI_BASE_URL=

# Organization API key (Settings -> API keys) or a Personal Access Token.
# Sent as `Authorization: Bearer <key>`. A PAT acts as a single user and cannot
# use SCIM or `userId` impersonation.
OMNI_API_KEY=

# Per-request timeout in seconds.
# OMNI_REQUEST_TIMEOUT_SECONDS=60

# Extra attempts on 429 (honouring Retry-After) and 502/503/504.
# OMNI_MAX_RETRIES=3

# Tool results are truncated below this many characters (MCP caps results at 1 MB).
# OMNI_MAX_RESULT_CHARS=900000

# Set to 1 to allow the destructive live test suite (creates/deletes real objects).
# OMNI_TEST_ALLOW_DESTRUCTIVE=

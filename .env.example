# Omni MCP server configuration.
# Copy to .env and fill in. NEVER commit .env.

# Your instance URL, e.g. https://your-instance.omniapp.co
# A trailing /api is accepted and normalised away.
OMNI_BASE_URL=

# Organization API key (Settings -> API access -> Organization keys) or a Personal
# Access Token (Profile -> Manage account -> Generate token; listed under
# Settings -> API access -> Personal tokens).
# Sent as `Authorization: Bearer <key>`. A PAT acts as a single user and cannot
# use SCIM or `userId` impersonation.
OMNI_API_KEY=

# Per-request timeout in seconds.
# OMNI_REQUEST_TIMEOUT_SECONDS=60

# Extra attempts on 429 (honouring Retry-After) and 502/503/504.
# OMNI_MAX_RETRIES=3

# Tool results are truncated below this many characters (MCP caps results at 1 MB).
# OMNI_MAX_RESULT_CHARS=900000

# Comma-separated allowlist of tool modules to register. Unset or empty registers
# all 20 modules (198 tools, ~686 KB of tool schemas in every request). An unknown
# name is a startup error listing the valid ones. Examples:
#   modelling      models,model_git,queries,content,health
#   administration users,user_groups,identity,connections,schedules,health
# OMNI_TOOL_MODULES=

# Set to 1 to allow the destructive live test suite (creates/deletes real objects).
# OMNI_TEST_ALLOW_DESTRUCTIVE=
